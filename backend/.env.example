# =========================================
# APPLICATION
# =========================================

APP_NAME=CraftMitra API
APP_VERSION=1.0.0


# =========================================
# DATABASE
# =========================================

DATABASE_URL=postgresql+psycopg://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME


# =========================================
# SECURITY
# =========================================

SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# =========================================
# ENVIRONMENT
# =========================================

ENVIRONMENT=development